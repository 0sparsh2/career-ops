# Copy to .env and fill in (never commit .env)

# NVIDIA NIM (primary) — OpenAI-compatible: https://integrate.api.nvidia.com/v1
# Streamlit screener accepts NVIDIA_API_KEY or NVIDIA_NIM_API (same nvapi-… value)
NVIDIA_API_KEY=
# NVIDIA_NIM_API=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
OPENCODE_MODEL=nvidia-nim/deepseek-ai/deepseek-v4-pro
OPENCODE_MODEL_FALLBACK=ollama/gemma4:e4b

# Optional: Google Gemini (only if you switch OPENCODE_MODEL to google/...)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview


